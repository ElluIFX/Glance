                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <TextBlock x:Name="PathCopyGroupLabel" x:Uid="PathCopyGroupLabel" VerticalAlignment="Center" Text="Path copying" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
