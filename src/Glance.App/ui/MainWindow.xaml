<Window
    x:Class="Glance.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="PreviewTitleBar"
            Grid.Row="0"
            Padding="12,0,6,0"
            Canvas.ZIndex="100">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Grid.OpacityTransition>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                x:Uid="BackButton"
                Grid.Column="0"
                Style="{StaticResource IconButtonStyle}"
                Margin="0,0,4,0"
                Click="BackButton_Click"
                ToolTipService.ToolTip="Back"
                Visibility="Collapsed">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="1"
                Background="Transparent">
                <TextBlock
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
            <ToggleButton
                x:Name="PreviewModeButton"
                Grid.Column="2"
                Style="{StaticResource IconToggleButtonStyle}"
                Margin="4,0,0,0"
                Click="PreviewModeButton_Click"
                Visibility="Collapsed">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE7C3;" />
            </ToggleButton>
            <ToggleButton
                x:Name="PinButton"
                x:Uid="PinButton"
                Grid.Column="3"
                Style="{StaticResource IconToggleButtonStyle}"
                Margin="4,0,0,0"
                Click="PinButton_Click"
                ToolTipService.ToolTip="Pin file">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE718;" />
            </ToggleButton>
            <ToggleButton
                x:Name="TopmostButton"
                x:Uid="TopmostButton"
                Grid.Column="4"
                Style="{StaticResource IconToggleButtonStyle}"
                Margin="4,0,0,0"
                Click="TopmostButton_Click"
                ToolTipService.ToolTip="Always visible">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE74A;" />
            </ToggleButton>
            <ToggleButton
                x:Name="FullscreenButton"
                Grid.Column="5"
                Style="{StaticResource IconToggleButtonStyle}"
                Margin="4,0,0,0"
                Click="FullscreenButton_Click"
                ToolTipService.ToolTip="Enter full screen">
                <FontIcon
                    x:Name="FullscreenIcon"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Glyph="&#xE740;" />
            </ToggleButton>
            <Button
                x:Name="ClosePreviewButton"
                x:Uid="ClosePreviewButton"
                Grid.Column="6"
                Style="{StaticResource IconButtonStyle}"
                Margin="4,0,0,0"
                Click="ClosePreviewButton_Click"
                ToolTipService.ToolTip="Close preview">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <Grid
            x:Name="PreviewContentHost"
            Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FileListColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="FileListPanel"
                Grid.Column="0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,2,4,2">
                        <TextBlock x:Name="FileListCountText" Margin="8,0,30,0"
                            VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="FileListToggleButton" HorizontalAlignment="Right"
                            Style="{StaticResource IconButtonStyle}" Width="28" Height="28">
                            <FontIcon x:Name="FileListToggleIcon" FontSize="12" Glyph="&#xE76B;" />
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="FileList"
                        Grid.Row="1"
                        Margin="4,0,4,6"
                        Padding="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        SelectionMode="Single"
                        ContainerContentChanging="FileList_ContainerContentChanging"
                        SelectionChanged="FileList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="CornerRadius" Value="4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16">
                                        <FontIcon
                                            x:Name="FileListFallbackIcon"
                                            FontSize="16"
                                            Glyph="&#xE8A5;"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Image
                                            x:Name="FileListIcon"
                                            Stretch="Uniform"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="FileListNameText"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="FileListExtensionText"
                                        Grid.Column="2"
                                        MaxWidth="52"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border x:Name="FileListResizeHandle" Grid.Column="0" Width="6"
                HorizontalAlignment="Right" Background="Transparent" Visibility="Collapsed" />

            <Grid Grid.Column="1" x:Name="PreviewCanvas">
                <Grid
                    x:Name="GenericPanel"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="10">
                    <Grid Width="64" Height="64">
                        <Image
                            x:Name="GenericFileIconImage"
                            Width="64"
                            Height="64"
                            Stretch="Uniform"
                            Visibility="Collapsed" />
                        <FontIcon
                            x:Name="GenericFileFallbackIcon"
                            FontSize="56"
                            Glyph="&#xE8A5;" />
                    </Grid>
                    <TextBlock
                        x:Name="FileNameText"
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="FilePathText"
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="FileMetadataText"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ScrollViewer
                        x:Name="GenericAdvancedInfoScroller"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        MaxWidth="720"
                        MaxHeight="240"
                        HorizontalAlignment="Center"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="GenericAdvancedInfoText"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="NoWrap" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Spacing="10">
                    <Button
                        x:Name="LoadCloudFileButton"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Click="LoadCloudFileButton_Click"
                        Visibility="Collapsed">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE753;" />
                                <TextBlock x:Name="LoadCloudFileText" x:Uid="LoadCloudFileText" Text="Load file" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <StackPanel x:Name="GenericPreviewActions" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="PreviewAsGuessedFormatButton" Visibility="Collapsed"
                        IsTabStop="False" AllowFocusOnInteraction="False"
                        Click="PreviewAsGuessedFormatButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                            <TextBlock x:Name="PreviewAsIdentifiedFormatText" x:Uid="PreviewAsIdentifiedFormatText" Text="Preview as identified format" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    <TextBlock
                        x:Name="ComponentLoadingText"
                        MaxWidth="620"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ErrorText"
                        MaxWidth="620"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="TextPanel" Visibility="Collapsed">
                    <Grid
                        x:Name="TextEditorHost"
                        Loaded="TextEditorHost_Loaded"
                        SizeChanged="TextEditorHost_SizeChanged" />
                    <Grid
                        x:Name="WebPreviewHost"
                        Visibility="Collapsed" />
                    <Grid
                        x:Name="JsonTreeHost"
                        Background="Transparent"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            x:Name="JsonTreeToolbar"
                            Grid.Row="0"
                            MinHeight="36"
                            Padding="8,4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            ColumnSpacing="12">
                            <Grid.Resources>
                                <Style x:Key="JsonDepthButtonStyle" TargetType="Button">
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="AllowFocusOnInteraction" Value="False" />
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="MinWidth" Value="28" />
                                    <Setter Property="Padding" Value="7,0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FontSize" Value="11" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button
                                    x:Name="JsonDepth1Button"
                                    x:Uid="JsonDepth1Button"
                                    Style="{StaticResource JsonDepthButtonStyle}"
                                    Click="JsonDepthButton_Click"
                                    Content="1"
                                    Tag="1"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="JsonDepth2Button"
                                    x:Uid="JsonDepth2Button"
                                    Style="{StaticResource JsonDepthButtonStyle}"
                                    Click="JsonDepthButton_Click"
                                    Content="2"
                                    Tag="2"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="JsonDepth3Button"
                                    x:Uid="JsonDepth3Button"
                                    Style="{StaticResource JsonDepthButtonStyle}"
                                    Click="JsonDepthButton_Click"
                                    Content="3"
                                    Tag="3"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="JsonDepth4Button"
                                    x:Uid="JsonDepth4Button"
                                    Style="{StaticResource JsonDepthButtonStyle}"
                                    Click="JsonDepthButton_Click"
                                    Content="4"
                                    Tag="4"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="JsonDepth5Button"
                                    x:Uid="JsonDepth5Button"
                                    Style="{StaticResource JsonDepthButtonStyle}"
                                    Click="JsonDepthButton_Click"
                                    Content="5"
                                    Tag="5"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="JsonExpandAllButton"
                                    x:Uid="JsonExpandAllButton"
                                    Style="{StaticResource JsonDepthButtonStyle}"
                                    Click="JsonDepthButton_Click"
                                    Content="All"
                                    Tag="all"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock
                                x:Name="JsonStatisticsText"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="11"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ListView
                            x:Name="JsonTreeList"
                            Grid.Row="1"
                            Padding="8"
                            Background="Transparent"
                            ContainerContentChanging="JsonTreeList_ContainerContentChanging"
                            IsItemClickEnabled="True"
                            ItemClick="JsonTreeList_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        MinHeight="30"
                                        Background="Transparent"
                                        PointerPressed="JsonTreeRow_PointerPressed" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <StackPanel
                            x:Name="JsonParsingOverlay"
                            Grid.RowSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Spacing="12">
                            <ProgressRing Width="32" Height="32" IsActive="True" />
                            <TextBlock
                                x:Name="JsonParsingText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid
                        x:Name="TextLoadingOverlay"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                            </Style>
                        </Grid.Style>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <ProgressRing Width="32" Height="32" IsActive="True" />
                            <TextBlock
                                x:Name="TextLoadingText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid
                    x:Name="ImagePanel"
                    SizeChanged="ImagePanel_SizeChanged"
                    Visibility="Collapsed">
                    <ScrollViewer
                        x:Name="ImageScroller"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        MaxZoomFactor="16"
                        MinZoomFactor="1"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled"
                        ZoomMode="Enabled"
                        ViewChanged="ImageScroller_ViewChanged"
                        PointerCanceled="ImageScroller_PointerCanceled"
                        PointerCaptureLost="ImageScroller_PointerCaptureLost"
                        PointerMoved="ImageScroller_PointerMoved"
                        PointerPressed="ImageScroller_PointerPressed"
                        PointerReleased="ImageScroller_PointerReleased">
                        <Grid
                            x:Name="ImageFitSurface"
                            Background="Transparent"
                            PointerWheelChanged="ImageScroller_PointerWheelChanged">
                            <Image
                                x:Name="ImagePreview"
                                HorizontalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5"
                                Stretch="Uniform"
                                VerticalAlignment="Center">
                                <Image.RenderTransform>
                                    <CompositeTransform x:Name="ImageTransform" />
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                    </ScrollViewer>
                    <Border
                        x:Name="ImageZoomMapOverlay"
                        Margin="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#99000000"
                        CornerRadius="4"
                        PointerCanceled="ImageZoomMapOverlay_PointerCanceled"
                        PointerCaptureLost="ImageZoomMapOverlay_PointerCaptureLost"
                        PointerMoved="ImageZoomMapOverlay_PointerMoved"
                        PointerPressed="ImageZoomMapOverlay_PointerPressed"
                        PointerReleased="ImageZoomMapOverlay_PointerReleased"
                        Visibility="Collapsed">
                        <Canvas x:Name="ImageZoomMapCanvas">
                            <Border
                                x:Name="ImageZoomMapBaseFrame"
                                CornerRadius="4"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <CompositeTransform x:Name="ImageZoomMapBaseTransform" />
                                </Border.RenderTransform>
                                <Image
                                    x:Name="ImageZoomMapBaseImage"
                                    Opacity="0.45"
                                    Source="{Binding Source, ElementName=ImagePreview}"
                                    Stretch="Fill" />
                            </Border>
                            <Canvas x:Name="ImageZoomMapViewportLayer">
                                <Canvas.Clip>
                                    <RectangleGeometry x:Name="ImageZoomMapViewportClip" />
                                </Canvas.Clip>
                                <Border
                                    x:Name="ImageZoomMapViewportFrame"
                                    CornerRadius="4"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <CompositeTransform x:Name="ImageZoomMapViewportTransform" />
                                    </Border.RenderTransform>
                                    <Image
                                        x:Name="ImageZoomMapViewportImage"
                                        Opacity="0.9"
                                        Source="{Binding Source, ElementName=ImagePreview}"
                                        Stretch="Fill" />
                                </Border>
                            </Canvas>
                            <Border
                                x:Name="ImageZoomMapViewportBorder"
                                Background="#18FFFFFF"
                                BorderBrush="White"
                                BorderThickness="2"
                                Opacity="0.75" />
                        </Canvas>
                    </Border>
                    <Border
                        x:Name="ImageMetadataOverlay"
                        Margin="12"
                        MaxWidth="440"
                        MaxHeight="360"
                        Padding="10,7"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#B3202020"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <RichTextBlock
                                x:Name="ImageMetadataText"
                                Foreground="White"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid
                    x:Name="MediaPanel"
                    Loaded="NativeDocumentPanel_Loaded"
                    PointerMoved="MediaPanel_PointerMoved"
                    PointerPressed="MediaPanel_PointerPressed"
                    Tapped="MediaPanel_Tapped"
                    PointerWheelChanged="MediaPanel_PointerWheelChanged"
                    SizeChanged="NativeDocumentPanel_SizeChanged"
                    Visibility="Collapsed">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                        </Style>
                    </Grid.Style>
                    <MediaPlayerElement
                        x:Name="MediaPreview"
                        AreTransportControlsEnabled="False"
                        AutoPlay="False"
                        Stretch="Uniform" />
                    <Grid
                        x:Name="AudioMetadataPanel"
                        MaxWidth="760"
                        Padding="32,28,32,84"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="200" Height="200">
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4">
                                <FontIcon
                                    x:Name="MediaCoverPlaceholder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="64"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8D6;" />
                            </Border>
                            <Image
                                x:Name="MediaCoverImage"
                                Stretch="UniformToFill"
                                Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                            <TextBlock
                                x:Name="MediaTitleText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="MediaAlbumText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="15"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="MediaArtistText"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                FontSize="13"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <StackPanel
                        x:Name="NativeMediaLoadingOverlay"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <ProgressRing Width="32" Height="32" IsActive="True" />
                    </StackPanel>
                    <Border
                        x:Name="MediaPausedOverlay"
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#E6000000"
                        CornerRadius="36"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Path Width="8" Height="30" Fill="White" Stretch="Fill"
                                Data="M5.74609 3C4.7796 3 3.99609 3.7835 3.99609 4.75V19.25C3.99609 20.2165 4.7796 21 5.74609 21H9.24609C10.2126 21 10.9961 20.2165 10.9961 19.25V4.75C10.9961 3.7835 10.2126 3 9.24609 3H5.74609Z" />
                            <Path Width="8" Height="30" Fill="White" Stretch="Fill"
                                Data="M5.74609 3C4.7796 3 3.99609 3.7835 3.99609 4.75V19.25C3.99609 20.2165 4.7796 21 5.74609 21H9.24609C10.2126 21 10.9961 20.2165 10.9961 19.25V4.75C10.9961 3.7835 10.2126 3 9.24609 3H5.74609Z" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="MediaControlsOverlay"
                        Height="56"
                        Padding="10,0"
                        VerticalAlignment="Bottom">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                            </Style>
                        </Border.Style>
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.18" />
                        </Border.OpacityTransition>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="MediaPlayPauseButton"
                                x:Uid="MediaPlayPauseButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="MediaPlayPauseButton_Click"
                                ToolTipService.ToolTip="Play or pause">
                                <FontIcon x:Name="MediaPlayPauseIcon" FontSize="14" Glyph="&#xE769;" />
                            </Button>
                            <Slider
                                x:Name="MediaSeekSlider"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsThumbToolTipEnabled="False"
                                ValueChanged="MediaSeekSlider_ValueChanged" />
                            <TextBlock
                                x:Name="MediaTimeText"
                                Grid.Column="2"
                                MinWidth="92"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Text="0:00 / 0:00" />
                            <Button
                                x:Name="MediaMuteButton"
                                x:Uid="MediaMuteButton"
                                Grid.Column="3"
                                Style="{StaticResource IconButtonStyle}"
                                Click="MediaMuteButton_Click"
                                ToolTipService.ToolTip="Mute or unmute">
                                <FontIcon
                                    x:Name="MediaMuteIcon"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="16"
