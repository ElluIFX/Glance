                    <Button x:Name="SearchPreviousButton" Style="{StaticResource IconButtonStyle}"><FontIcon FontSize="12" Glyph="&#xE70E;"/></Button>
                    <Button x:Name="SearchNextButton" Style="{StaticResource IconButtonStyle}"><FontIcon FontSize="12" Glyph="&#xE70D;"/></Button>
                    <Button x:Name="SearchCloseButton" Style="{StaticResource IconButtonStyle}"><FontIcon FontSize="12" Glyph="&#xE711;"/></Button>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="JsonSearchScope" MinWidth="132" Visibility="Collapsed" FontSize="12">
                        <ComboBoxItem x:Name="JsonSearchBoth"/><ComboBoxItem x:Name="JsonSearchKeys"/><ComboBoxItem x:Name="JsonSearchValues"/>
                    </ComboBox>
                    <TextBlock x:Name="TextSearchStatus" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Button
            x:Name="TextSelectionCopyButton"
            CornerRadius="4"
            Opacity="0.9"
            Grid.Row="1"
            Margin="16,0,16,32"
            Padding="18,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="90"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            IsTabStop="False"
            AllowFocusOnInteraction="False"
            Visibility="Collapsed"
            Click="TextSelectionCopyButton_Click" />

        <Border
            x:Name="TextFontSizeOverlay"
            Grid.RowSpan="3"
            MinWidth="88"
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Canvas.ZIndex="100"
            CornerRadius="6"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock
                x:Name="TextFontSizeOverlayText"
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold" />
        </Border>

        <StackPanel
            x:Name="PreviewNoticeStack"
            Grid.RowSpan="3"
            Margin="16,52,16,0"
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Canvas.ZIndex="200"
            Spacing="8">
            <StackPanel.Resources>
                <ResourceDictionary>
                    <Style TargetType="InfoBar">
                        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                    </Style>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#005FB8" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#60CDFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="InfoBarInformationalSeverityIconBackground" ResourceKey="SystemColorHighlightColorBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </StackPanel.Resources>
        </StackPanel>
        <Grid Grid.Row="1" IsHitTestVisible="False" Visibility="Collapsed" x:Name="GalleryControlStorage">
            <Button x:Name="GalleryPreviousButton" Width="40" Height="48" CornerRadius="8"
                Style="{StaticResource IconButtonStyle}" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Opacity="0.6" Visibility="Collapsed">
                <FontIcon FontSize="18" Glyph="&#xE76B;" />
            </Button>
            <Button x:Name="GalleryNextButton" Width="40" Height="48" CornerRadius="8"
                Style="{StaticResource IconButtonStyle}" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Opacity="0.6" Visibility="Collapsed">
                <FontIcon FontSize="18" Glyph="&#xE76C;" />
            </Button>
            <Border x:Name="GalleryProgressPanel" Padding="12,4" CornerRadius="8"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Opacity="0.6" Visibility="Collapsed">
                <StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GalleryPositionText" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="GalleryFileNameText" Grid.Column="1" FontSize="12"
                            VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding Text, ElementName=GalleryFileNameText}" />
                    </Grid>
                    <Slider x:Name="GalleryPositionSlider" MinWidth="100" StepFrequency="1"
                        IsThumbToolTipEnabled="False" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
