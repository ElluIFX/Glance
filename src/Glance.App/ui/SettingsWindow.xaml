                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ComponentsPageTitle" x:Uid="ComponentsPageTitle" Style="{StaticResource SettingsPageTitleStyle}" Text="Components" />
                        <TextBlock x:Name="ComponentsPageDescription" x:Uid="ComponentsPageDescription" Style="{StaticResource SettingsDescriptionStyle}" Text="Install and manage optional preview support" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ComponentLocationGroupTitle" x:Uid="ComponentLocationGroupTitle" Style="{StaticResource SettingsGroupTitleStyle}" Text="Add-on component location" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="ComponentFolderLabel" x:Uid="ComponentFolderLabel" Text="Component folder" />
                                    <TextBlock x:Name="ComponentFolderDescription" x:Uid="ComponentFolderDescription" Style="{StaticResource SettingsDescriptionStyle}" Text="Glance loads components from this folder at startup" />
                                </StackPanel>
                                <Button x:Name="OpenComponentsFolderButton" x:Uid="OpenComponentsFolderButton" Grid.Column="1" Click="OpenComponentsFolderButton_Click" Content="Open folder" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Expander
                        x:Name="ComponentStatusExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0">
                        <Expander.Header>
                            <TextBlock x:Name="ComponentStatusGroupTitle" x:Uid="ComponentStatusGroupTitle" Style="{StaticResource SettingsGroupTitleStyle}" Text="Add-on component status" />
                        </Expander.Header>
                        <Grid>
                            <Grid
                                x:Name="ComponentEmptyState"
                                MinHeight="160">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="32"
                                        Glyph="&#xE950;"
                                        Opacity="0.65" />
                                    <TextBlock
                                        x:Name="ComponentEmptyTitle"
                                        x:Uid="ComponentEmptyTitle"
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="No components installed" />
                                    <TextBlock
                                        x:Name="ComponentEmptyDescription"
                                        x:Uid="ComponentEmptyDescription"
                                        MaxWidth="360"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SettingsDescriptionStyle}"
                                        Text="Install optional components to add support for more file formats"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                x:Name="ComponentStatusScroller"
                                Visibility="Collapsed">
                                <StackPanel x:Name="ComponentStatusList" />
                            </Grid>
                        </Grid>
                    </Expander>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SourceLocationGroupTitle" x:Uid="SourceLocationGroupTitle" Style="{StaticResource SettingsGroupTitleStyle}" Text="Add-on source location" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="SourceFolderLabel" x:Uid="SourceFolderLabel" Text="Source folder" />
                                    <TextBlock x:Name="SourceFolderDescription" x:Uid="SourceFolderDescription" Style="{StaticResource SettingsDescriptionStyle}" Text="Glance loads sources from this folder at startup" />
                                </StackPanel>
                                <Button x:Name="OpenSourcesFolderButton" x:Uid="OpenSourcesFolderButton" Grid.Column="1" Click="OpenSourcesFolderButton_Click" Content="Open folder" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Expander
                        x:Name="SourceStatusExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0">
                        <Expander.Header>
                            <TextBlock x:Name="SourceStatusGroupTitle" x:Uid="SourceStatusGroupTitle" Style="{StaticResource SettingsGroupTitleStyle}" Text="Add-on source status" />
                        </Expander.Header>
                        <Grid>
                            <Grid x:Name="SourceEmptyState" MinHeight="120">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <FontIcon HorizontalAlignment="Center" FontSize="32" Glyph="&#xE950;" Opacity="0.65" />
                                    <TextBlock x:Name="SourceEmptyTitle" x:Uid="SourceEmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" Text="No sources installed" />
                                    <TextBlock x:Name="SourceEmptyDescription" x:Uid="SourceEmptyDescription" MaxWidth="360" HorizontalAlignment="Center" Style="{StaticResource SettingsDescriptionStyle}" Text="Install optional sources to preview files from supported applications" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                x:Name="SourceStatusScroller"
                                Visibility="Collapsed">
                                <StackPanel x:Name="SourceStatusList" />
                            </Grid>
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="MaintenanceSettingsPanel"
                HorizontalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="MaintenancePageTitle" x:Uid="MaintenancePageTitle" Style="{StaticResource SettingsPageTitleStyle}" Text="Maintenance" />
                        <TextBlock x:Name="MaintenancePageDescription" x:Uid="MaintenancePageDescription" Style="{StaticResource SettingsDescriptionStyle}" Text="Runtime status, diagnostics, and saved application state" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="RuntimeStatusGroupTitle" x:Uid="RuntimeStatusGroupTitle" Style="{StaticResource SettingsGroupTitleStyle}" Text="Runtime status" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="InputCoreLabel" x:Uid="InputCoreLabel" Text="Input core" />
                                    <TextBlock x:Name="CoreStatusText" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon x:Name="CoreStatusIcon" Grid.Column="1" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="AdministratorAccessLabel" x:Uid="AdministratorAccessLabel" Text="Administrator access" />
                                    <TextBlock x:Name="AdministratorAccessStatusText" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon x:Name="AdministratorAccessStatusIcon" Grid.Column="1" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="WebViewAvailabilityLabel" x:Uid="WebViewAvailabilityLabel" Text="WebView2 availability" />
                                    <TextBlock x:Name="WebViewAvailabilityStatusText" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <HyperlinkButton
                                        x:Name="WebViewDownloadLink"
                                        x:Uid="WebViewDownloadLink"
                                        Padding="0"
                                        Content="Download WebView2"
                                        NavigateUri="https://developer.microsoft.com/en-us/microsoft-edge/webview2/"
                                        Visibility="Collapsed" />
                                    <FontIcon x:Name="WebViewAvailabilityStatusIcon" FontSize="18" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="MaintenanceActionsGroupTitle" x:Uid="MaintenanceActionsGroupTitle" Style="{StaticResource SettingsGroupTitleStyle}" Text="Maintenance actions" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="DiagnosticsTitle" x:Uid="DiagnosticsTitle" Text="Save diagnostic information" />
                                    <TextBlock x:Name="DiagnosticsDescription" x:Uid="DiagnosticsDescription" Style="{StaticResource SettingsDescriptionStyle}" Text="Save diagnostic logs and crash dumps" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="DiagnosticsToggle"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    OffContent="{x:Null}"
                                    OnContent="{x:Null}"
                                    VerticalAlignment="Center"
                                    Toggled="DiagnosticsToggle_Toggled" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="DiagnosticBundleLabel" x:Uid="DiagnosticBundleLabel" Text="Export diagnostic package" />
                                    <TextBlock x:Name="DiagnosticBundleStatusText" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="ExportDiagnosticBundleButton"
                                    x:Uid="ExportDiagnosticBundleButton"
                                    Grid.Column="1"
                                    MinWidth="88"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="ExportDiagnosticBundleButton_Click"
                                    Content="Export" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="ResetAllSettingsLabel" x:Uid="ResetAllSettingsLabel" Text="Reset all settings" />
                                    <TextBlock x:Name="ResetAllSettingsDescription" x:Uid="ResetAllSettingsDescription" Style="{StaticResource SettingsDescriptionStyle}" Text="Clear saved preferences and exit Glance" />
                                </StackPanel>
                                <Button
                                    x:Name="ResetAllSettingsButton"
                                    x:Uid="ResetAllSettingsButton"
                                    Grid.Column="1"
                                    MinWidth="88"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="ResetAllSettingsButton_Click"
                                    Content="Reset" />
                            </Grid>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="AboutSettingsPanel"
                HorizontalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="AboutPageTitle" x:Uid="AboutPageTitle" Style="{StaticResource SettingsPageTitleStyle}" Text="About" />
                        <TextBlock x:Name="AboutPageDescription" x:Uid="AboutPageDescription" Style="{StaticResource SettingsDescriptionStyle}" Text="Application information" />
                    </StackPanel>
                    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Spacing="10">
                        <Image
                            Width="144"
                            Height="144"
                            Source="Assets/AppIcon.png"
                            Stretch="Uniform" />
                        <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="Glance" />
                        <TextBlock x:Name="AboutVersionText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="CheckForUpdatesButton"
                                x:Uid="CheckForUpdatesButton"
                                Click="CheckForUpdatesButton_Click"
                                Content="Check for updates" />
                            <ProgressRing
                                x:Name="UpdateCheckProgressRing"
                                Width="18"
                                Height="18"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="AboutAuthorLabel" x:Uid="AboutAuthorLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Author" />
                            <HyperlinkButton Padding="0" Content="@Ellu" NavigateUri="https://github.com/ElluIFX" />
                        </StackPanel>
                        <TextBlock x:Name="AboutLicenseText" x:Uid="AboutLicenseText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="License: GPL-3.0" />
                        <HyperlinkButton x:Name="AboutProjectLink" x:Uid="AboutProjectLink" HorizontalAlignment="Center" Content="GitHub repository" NavigateUri="https://github.com/ElluIFX/Glance" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </NavigationView>
        <Grid
            x:Name="UpdateOverlay"
            Grid.Row="1"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Border
                x:Name="UpdateCard"
                Width="360"
                Padding="28,26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel HorizontalAlignment="Stretch" Spacing="10">
                    <Grid
                        Width="104"
                        Height="104"
                        HorizontalAlignment="Center">
                        <ProgressRing
                            x:Name="UpdateProgressRing"
                            Width="96"
                            Height="96"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            IsActive="True"
                            IsIndeterminate="False"
                            Maximum="100"
                            Minimum="0" />
                        <TextBlock
                            x:Name="UpdateProgressPercentText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="0%" />
                    </Grid>
                    <TextBlock
                        x:Name="UpdateCardTitle"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Name="UpdateCardMessage"
                        HorizontalAlignment="Stretch"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="UpdateProgressBytesText"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center" />
                    <Button
                        x:Name="CancelUpdateButton"
                        HorizontalAlignment="Center"
                        Click="CancelUpdateButton_Click"
                        Content="Cancel" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
