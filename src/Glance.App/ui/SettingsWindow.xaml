<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Glance.App.SettingsWindow">
    <Grid x:Name="RootGrid">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="14,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="SettingsTitleBarDragRegion" Grid.Column="0" Background="Transparent">
                <TextBlock x:Name="SettingsTitleText" x:Uid="SettingsTitleText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Settings" />
            </Grid>
            <Button x:Name="CloseSettingsButton" x:Uid="CloseSettingsButton" Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource IconButtonStyle}" Click="CloseSettingsButton_Click" ToolTipService.ToolTip="Close settings">
                <FontIcon FontSize="16" Glyph="" />
            </Button>
        </Grid>
        <NavigationView x:Name="SettingsNavigation" Grid.Row="1" AlwaysShowHeader="False" Background="Transparent" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" OpenPaneLength="190" PaneDisplayMode="Left" SelectionChanged="SettingsNavigation_SelectionChanged">
            <NavigationView.MenuItems>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNavigationItem" x:Uid="AboutNavigationItem" Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ExitButton" Margin="0,0,0,8" SelectsOnInvoked="False" Tapped="ExitButton_Tapped">
                    <NavigationViewItem.Icon>
                        <FontIcon FontSize="16" Glyph="&#xE711;" />
                    </NavigationViewItem.Icon>
                    <TextBlock x:Name="ExitButtonText" x:Uid="ExitButtonText" Text="Exit Glance" />
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid Padding="32,24,20,28" x:Name="SettingsPageHost">
                <ScrollViewer x:Name="AboutSettingsPanel" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="720" Margin="0,0,16,0" HorizontalAlignment="Stretch" Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="AboutPageTitle" x:Uid="AboutPageTitle" Style="{StaticResource SettingsPageTitleStyle}" Text="About" />
                            <TextBlock x:Name="AboutPageDescription" x:Uid="AboutPageDescription" Style="{StaticResource SettingsDescriptionStyle}" Text="Application information" />
                        </StackPanel>
                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Spacing="10">
                            <Image Width="144" Height="144" Source="Assets/AppIcon.png" Stretch="Uniform" />
                            <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="Glance" />
                            <TextBlock x:Name="AboutVersionText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="CheckForUpdatesButton" x:Uid="CheckForUpdatesButton" Click="CheckForUpdatesButton_Click" Content="Check for updates" IsTabStop="False" AllowFocusOnInteraction="False" />
                                <ProgressRing x:Name="UpdateCheckProgressRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="AboutAuthorLabel" x:Uid="AboutAuthorLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Author" />
                                <HyperlinkButton Padding="0" Content="@Ellu" NavigateUri="https://github.com/ElluIFX" IsTabStop="False" AllowFocusOnInteraction="False" />
                            </StackPanel>
                            <TextBlock x:Name="AboutLicenseText" x:Uid="AboutLicenseText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="License: GPL-3.0" />
                            <HyperlinkButton x:Name="AboutProjectLink" x:Uid="AboutProjectLink" HorizontalAlignment="Center" Content="GitHub repository" NavigateUri="https://github.com/ElluIFX/Glance" IsTabStop="False" AllowFocusOnInteraction="False" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
        <Grid x:Name="UpdateOverlay" Grid.Row="1" Background="{ThemeResource SmokeFillColorDefaultBrush}" Visibility="Collapsed">
            <Border x:Name="UpdateCard" Width="360" Padding="28,26" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel HorizontalAlignment="Stretch" Spacing="10">
                    <Grid Width="104" Height="104" HorizontalAlignment="Center">
                        <ProgressRing x:Name="UpdateProgressRing" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AccentFillColorDefaultBrush}" IsActive="True" IsIndeterminate="False" Maximum="100" Minimum="0" />
                        <TextBlock x:Name="UpdateProgressPercentText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="0%" />
                    </Grid>
                    <TextBlock x:Name="UpdateCardTitle" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="UpdateCardMessage" HorizontalAlignment="Stretch" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="UpdateProgressBytesText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                    <Button x:Name="CancelUpdateButton" HorizontalAlignment="Center" Click="CancelUpdateButton_Click" Content="Cancel" IsTabStop="False" AllowFocusOnInteraction="False" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
