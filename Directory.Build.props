<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <PlatformToolset>v145</PlatformToolset>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <GlanceDistribution Condition="'$(GlanceDistribution)'==''">Portable</GlanceDistribution>
    <GlancePortable Condition="'$(GlanceDistribution)'=='Portable'">1</GlancePortable>
    <GlancePortable Condition="'$(GlancePortable)'==''">0</GlancePortable>
    <GlanceOutputRoot Condition="'$(GlanceOutputRoot)'=='' and '$(GlanceDistribution)'=='Portable'">$(SolutionDir)bin\Portable\$(Configuration)\x64\</GlanceOutputRoot>
    <GlanceOutputRoot Condition="'$(GlanceOutputRoot)'=='' and '$(Platform)'=='Win32'">$(SolutionDir)bin\$(Configuration)\x64\</GlanceOutputRoot>
    <GlanceOutputRoot Condition="'$(GlanceOutputRoot)'==''">$(SolutionDir)bin\$(Configuration)\$(Platform)\</GlanceOutputRoot>
    <OutDir>$(GlanceOutputRoot)</OutDir>
    <IntDir>$(SolutionDir)obj\$(ProjectName)\$(GlanceDistribution)\$(Configuration)\$(Platform)\</IntDir>
    <GeneratedFilesDir>$(IntDir)Generated Files\</GeneratedFilesDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <ConformanceMode>true</ConformanceMode>
      <TreatWarningAsError>true</TreatWarningAsError>
      <AdditionalOptions>/utf-8 /bigobj %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>GLANCE_PORTABLE=$(GlancePortable);UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>GLANCE_PORTABLE=$(GlancePortable);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <Target Name="ValidateGlanceDistribution" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GlanceDistribution)'!='Installed' and '$(GlanceDistribution)'!='Portable'" Text="GlanceDistribution must be Installed or Portable" />
  </Target>
</Project>
